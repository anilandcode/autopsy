    "html": "<!DOCTYPE html><html lang=\"en\" style=\"--announcement-banner-height: 42px;\"><body><div><!--$--><!--/$--></div><div class=\"AnnouncementBanner-module-scss-module__HROX5G__banner\" style=\"background-color:#F7F7F5\" role=\"region\" aria-label=\"Announcement\"><div class=\"AnnouncementBanner-module-scss-module__HROX5G__inner AnnouncementBanner-module-scss-module__HROX5G__alignCenter\"><div class=\"AnnouncementBanner-module-scss-module__HROX5G__content\"><p class=\"AnnouncementBanner-module-scss-module__HROX5G__text\"><a href=\"https://www.tavily.com/certification\" class=\"AnnouncementBanner-module-scss-module__HROX5G__inlineLink\">Get Tavily Certified Today</a>. Learn, take the quiz, and earn your certificate for API credits. </p></div></div></div><div class=\"Header-module-scss-module__5o-Mva__spacer\"></div><main class=\"PageModules-module-scss-module__L8QN1a__main\"><div class=\"page-module module-visible\"><section class=\"Hero-module-scss-module__wgR2gG__hero \"><div class=\"Hero-module-scss-module__wgR2gG__background\"><img alt=\"\" decoding=\"async\" data-nimg=\"fill\" class=\"Hero-module-scss-module__wgR2gG__backgroundImage\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"https://www.tavily.com/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F5tlb0lxv%2Fproduction%2F49a9b081b6c696977c112781c322aa1af700b435-3270x2000.png%3Frect%3D0%2C0%2C3270%2C1483%26w%3D1600&amp;w=3840&amp;q=75\"></div><div class=\"Hero-module-scss-module__wgR2gG__content\"><div class=\"Hero-module-scss-module__wgR2gG__headlineSection\"><h1 class=\"TextHeader-module-scss-module__Mcjc0W__h1 h1\">Connect your AI agents <span class=\"Hero-module-scss-module__wgR2gG__titleHighlight\" style=\"--bg-image:url(https://cdn.sanity.io/images/5tlb0lxv/production/4f751e577e80c52360bff4761cb72fcc7b6a71d8-1340x789.png?w=1600)\">to the web</span></h1><p class=\"Hero-module-scss-module__wgR2gG__subtitle\">Real-time search, extract